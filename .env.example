# Copy this file to .env and fill in real values. Never commit .env.

# --- General ---
APP_ENV=development
LOG_LEVEL=INFO
DEBUG_LOG_EMAIL_CONTENT=false

# --- Gmail / Google OAuth (see README section "Google Cloud project creation") ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/gmail/oauth/callback
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/gmail.compose

# Your own mailbox address - excluded from recruiter-candidate detection
MY_EMAIL=you@example.com

# --- Email detection mode ---
# polling  = local dev mode, periodic Gmail history sync (default, zero extra infra)
# pubsub   = production-style push notifications via Google Pub/Sub (advanced, optional)
EMAIL_MODE=polling
POLL_INTERVAL_SECONDS=60

# --- AI provider abstraction ---
# none   = fully deterministic (rule-based classification/extraction only)
# openai = uses OpenAI API (requires OPENAI_API_KEY, paid)
# ollama = uses a local Ollama model (free, requires Ollama running locally)
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- LLM-assisted resume customization (header role / summary / skills /
# experience bullets) - only engages when AI_PROVIDER is openai or ollama;
# AI_PROVIDER=none always uses the deterministic fallback regardless. ---
RESUME_LLM_CUSTOMIZATION_ENABLED=true
RESUME_LLM_MAX_SUMMARY_POINTS=2
RESUME_LLM_MAX_EXPERIENCE_POINTS=2
RESUME_LLM_MAX_SKILLS=6
RESUME_LLM_TIMEOUT_SECONDS=180

# --- Classification thresholds (0-1) ---
JOB_CLASSIFICATION_THRESHOLD=0.5
RECRUITER_EMAIL_CONFIDENCE_THRESHOLD=0.55

# --- Frontend ---
FRONTEND_ORIGIN=http://localhost:5173
